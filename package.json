{
  "name": "northwoods",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "lint:web": "pnpm --dir apps/web lint",
    "restore:dotnet": "mise exec -- dotnet restore src/Northwoods.slnx",
    "build:dotnet": "mise exec -- dotnet build src/Northwoods.slnx",
    "check": "pnpm build:web && pnpm build:dotnet",
    "test:unit": "dotnet test tests/Northwoods.Worker.UnitTests/Northwoods.Worker.UnitTests.csproj && dotnet test tests/Northwoods.Tenancy.UnitTests/Northwoods.Tenancy.UnitTests.csproj && dotnet test tests/Northwoods.Api.IntegrationTests/Northwoods.Api.IntegrationTests.csproj --filter \"Category!=runtime\"",
    "test:runtime": "dotnet test tests/Northwoods.Api.IntegrationTests/Northwoods.Api.IntegrationTests.csproj --filter \"Category=runtime\"",
    "test": "pnpm test:unit && pnpm test:runtime",
    "test:web-smoke": "pnpm --dir apps/web test:web-smoke",
    "test:e2e": "pnpm --dir apps/web test:e2e"
  }
}