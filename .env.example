# Local environment template for Northwoods
# Copy to `.env.local` (or `.env`) and fill in secrets.

# --- Core infra (defaults used by compose) ---
ConnectionStrings__Default=Host=localhost;Database=northwoods;Username=northwoods;Password=northwoods
Minio__Endpoint=localhost:9000
Minio__PublicEndpoint=localhost:9000
Minio__AccessKey=northwoods
Minio__SecretKey=northwoods
Minio__BucketName=intakes

# --- Extraction pipeline toggles ---
Extraction__UseAzureFallback=false
Extraction__UseOpenAiNormalizer=false
Extraction__UsePaddleOcr=false
Extraction__PaddleOcr__PythonPath=python3
Extraction__PaddleOcr__ScriptPath=scripts/paddle_extract.py
Extraction__MaxRetryAttempts=3
Extraction__RetryDelayMs=1000


# --- Auth / JWT ---
Auth__Jwt__SigningKey=change-me-at-least-32-chars-for-hs256
Auth__Jwt__Issuer=northwoods-api
Auth__Jwt__Audience=northwoods-web
Auth__Jwt__ExpiresInMinutes=120
Auth__ReviewerCanUpload=false

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_PROJECT_ID=
# OPENAI_ORG_ID=
Extraction__OpenAi__ModelNano=gpt-5.4-nano
Extraction__OpenAi__ModelMini=gpt-5.4-mini

# --- Azure Document Intelligence (optional stage) ---
Extraction__Azure__Endpoint=
Extraction__Azure__ApiKey=

# --- Confidence thresholds ---
Extraction__Thresholds__Escalate=0.82
Extraction__Thresholds__ReviewRequired=0.75
Extraction__Thresholds__AutoAccept=0.90
