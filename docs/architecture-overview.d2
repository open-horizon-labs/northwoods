direction: down

title: Northwoods Architecture {
  near: top-center
  shape: text
  style: {
    font-size: 32
    bold: true
  }
}

# --- Users (horizontal row) ---
users: {
  style: {
    fill: transparent
    stroke: transparent
  }
  iw: Intake Worker {
    shape: person
    style.fill: "#dbeafe"
    style.font-size: 16
  }
  rv: Reviewer {
    shape: person
    style.fill: "#dcfce7"
    style.font-size: 16
  }
  admin: Admin {
    shape: person
    style.fill: "#fef3c7"
    style.font-size: 16
  }
}

# --- Frontend ---
web: React + Vite + Tailwind + PDF.js {
  shape: rectangle
  style: {
    fill: "#e0f2fe"
    stroke: "#0ea5e9"
    border-radius: 8
    font-size: 16
  }
}

# --- API ---
api: Northwoods.Api (.NET 10) {
  style: {
    fill: "#faf5ff"
    stroke: "#a855f7"
    border-radius: 8
    font-size: 16
  }
  auth: JWT Auth\n+ tenant scoping {
    style.fill: "#f3e8ff"
    style.font-size: 14
  }
  endpoints: REST Endpoints {
    style.fill: "#f3e8ff"
    style.font-size: 14
  }
  rag: Hybrid RAG\n5-signal RRF fusion {
    style.fill: "#ede9fe"
    style.font-size: 14
    style.bold: true
  }
}

# --- Worker ---
worker: Extraction Worker (.NET 10) {
  style: {
    fill: "#fffbeb"
    stroke: "#f59e0b"
    border-radius: 8
    font-size: 16
  }
  pipeline: OpenAI Vision extraction\nnano → mini escalation {
    style.fill: "#fef3c7"
    style.font-size: 14
  }
  embed: Embedding generation\ntext-embedding-3-small {
    style.fill: "#fef3c7"
    style.font-size: 14
  }
}

# --- Data ---
pg: Postgres 18 + pgvector {
  shape: cylinder
  style: {
    fill: "#bbf7d0"
    stroke: "#22c55e"
    font-size: 16
    bold: true
  }
}

minio: MinIO (S3) {
  shape: cylinder
  style: {
    fill: "#bbf7d0"
    stroke: "#22c55e"
    font-size: 16
  }
}

# --- External ---
openai: OpenAI API {
  shape: cloud
  style: {
    fill: "#fecaca"
    stroke: "#ef4444"
    font-size: 16
  }
}

# --- Tenant isolation callout ---
rls: |md
  ## Row-Level Security on all 7 tables
  JWT carries tenant claim → `SET LOCAL app.tenant_id` per session
  Every query, every signal, every CTE is tenant-scoped
| {
  near: bottom-center
  shape: text
  style: {
    font-size: 18
    font-color: "#b91c1c"
    bold: true
  }
}

# --- Connections ---
users.iw -> web: upload
users.rv -> web: review
users.admin -> web: manage

web -> api.auth: JWT bearer {style.stroke: "#6366f1"}
api.auth -> api.endpoints
api.endpoints -> pg: queries + audit
api.endpoints -> minio: document blobs
api.rag -> pg: FTS + vector +\ntrigram + DOB

worker.pipeline -> openai: Vision API
worker.embed -> openai: Embeddings API
worker.pipeline -> pg: persist fields
worker.embed -> pg: update embeddings
